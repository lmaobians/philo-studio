{% extends 'account/base.html.twig' %}

{% set page_title = 'Change Password' %}

{% block account_body %}
    <div class="action-bar">
        <div>
            <h1 class="page-title-pink">Change Password</h1>
            <p class="admin-page-subtitle">Update the password used to sign in to your account.</p>
        </div>
        <div class="action-btn-group">
            <a href="{{ path('account_profile') }}" class="btn-act btn-cancel" style="display: inline-flex; align-items: center; text-decoration: none;">&larr; Back to Profile</a>
        </div>
    </div>

    <div class="table-card" style="max-width: 640px;">
        {% if errors is not empty %}
            <div class="auth-error" style="margin-bottom: 20px;">
                {% for error in errors %}
                    <div>{{ error }}</div>
                {% endfor %}
            </div>
        {% endif %}

        <form method="POST" action="{{ path('account_password') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('password_form') }}">

            <div class="form-group">
                <label>Current Password *</label>
                <input type="password" name="current_password" class="form-input" required autocomplete="current-password">
            </div>

            <div class="form-group">
                <label>New Password *</label>
                <input type="password" name="new_password" class="form-input" required minlength="8" autocomplete="new-password">
                <small class="admin-proof-help">At least 8 characters.</small>
            </div>

            <div class="form-group">
                <label>Confirm New Password *</label>
                <input type="password" name="confirm_password" class="form-input" required minlength="8" autocomplete="new-password">
            </div>

            <div class="action-btn-group" style="margin-top: 24px;">
                <button type="submit" class="btn-create">Update Password</button>
                <a href="{{ path('account_profile') }}" class="btn-act btn-cancel" style="display: inline-flex; align-items: center; text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}
