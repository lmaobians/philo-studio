{% extends 'admin/base.html.twig' %}

{% set page_title = isEdit ? 'Edit User Account' : 'Create User Account' %}

{% block admin_body %}
    <div class="action-bar">
        <div>
            <h1 class="page-title-pink">{{ isEdit ? 'Edit User Account' : 'Create User Account' }}</h1>
            <p class="admin-page-subtitle">
                {% if isEdit %}
                    Update account details, role and access status.
                {% else %}
                    Add a new administrator or staff account.
                {% endif %}
            </p>
        </div>
        <div class="action-btn-group">
            <a href="{{ path('admin_user_index') }}" class="btn-act btn-cancel" style="display: inline-flex; align-items: center; text-decoration: none;">&larr; Back to Users</a>
        </div>
    </div>

    <div class="table-card">
        {% if errors is not empty %}
            <div class="auth-error" style="margin-bottom: 20px;">
                {% for error in errors %}
                    <div>{{ error }}</div>
                {% endfor %}
            </div>
        {% endif %}

        {% if isEdit and isSelf|default(false) %}
            <div class="alert-toast" style="margin-bottom: 20px;">
                You are editing your own account. Your role and account status cannot be changed here. Use
                <a href="{{ path('account_profile') }}">Profile</a> to change your personal details.
            </div>
        {% endif %}

        <form method="POST" action="{{ isEdit ? path('admin_user_edit', {id: user.adminId}) : path('admin_user_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('user_form') }}">

            <div class="form-grid">
                <div class="form-group">
                    <label>Full Name *</label>
                    <input type="text" name="full_name" class="form-input" maxlength="100" required value="{{ form.fullName }}">
                </div>

                <div class="form-group">
                    <label>Username *</label>
                    <input type="text" name="username" class="form-input" maxlength="50" required value="{{ form.username }}" autocomplete="off">
                    <small class="admin-proof-help">Letters, numbers, dots, underscores, @ and hyphens only.</small>
                </div>

                <div class="form-group">
                    <label>Email Address *</label>
                    <input type="email" name="email" class="form-input" maxlength="180" required value="{{ form.email }}" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Role *</label>
                    {% if isEdit and isSelf|default(false) %}
                        <input type="text" class="form-input" value="{{ user.roleLabel }}" disabled>
                        <input type="hidden" name="role" value="{{ form.role }}">
                        <small class="admin-proof-help">You cannot change your own role.</small>
                    {% else %}
                        <select name="role" class="form-input" required>
                            <option value="ROLE_STAFF" {{ form.role == 'ROLE_STAFF' ? 'selected' : '' }}>Staff — own records only</option>
                            <option value="ROLE_ADMIN" {{ form.role == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrator — full system access</option>
                        </select>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label>Account Status *</label>
                    {% if isEdit and isSelf|default(false) %}
                        <input type="text" class="form-input" value="{{ user.status }}" disabled>
                        <input type="hidden" name="status" value="{{ form.status }}">
                        <small class="admin-proof-help">You cannot disable or archive your own account.</small>
                    {% else %}
                        <select name="status" class="form-input" required>
                            <option value="Active" {{ form.status == 'Active' ? 'selected' : '' }}>Active — can sign in</option>
                            <option value="Disabled" {{ form.status == 'Disabled' ? 'selected' : '' }}>Disabled — sign-in blocked</option>
                            <option value="Archived" {{ form.status == 'Archived' ? 'selected' : '' }}>Archived — sign-in blocked</option>
                        </select>
                    {% endif %}
                </div>
            </div>

            <h3 class="card-subtitle" style="margin-top: 24px;">
                {{ isEdit ? 'Reset Password (optional)' : 'Password' }}
            </h3>

            <div class="form-grid">
                <div class="form-group">
                    <label>{{ isEdit ? 'New Password' : 'Password *' }}</label>
                    <input type="password" name="{{ isEdit ? 'new_password' : 'password' }}" class="form-input" {{ isEdit ? '' : 'required' }} autocomplete="new-password">
                    {% if isEdit %}<small class="admin-proof-help">Leave blank to keep the current password.</small>{% endif %}
                </div>

                <div class="form-group">
                    <label>Confirm Password{{ isEdit ? '' : ' *' }}</label>
                    <input type="password" name="confirm_password" class="form-input" {{ isEdit ? '' : 'required' }} autocomplete="new-password">
                </div>
            </div>

            <div class="action-btn-group" style="margin-top: 24px;">
                <button type="submit" class="btn-create">{{ isEdit ? 'Save Changes' : 'Create Account' }}</button>
                <a href="{{ path('admin_user_index') }}" class="btn-act btn-cancel" style="display: inline-flex; align-items: center; text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}
