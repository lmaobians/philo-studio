{% extends 'admin/base.html.twig' %}

{% set page_title = 'Package Management' %}

{% block admin_body %}
    <div class="action-bar">
        <h1 class="page-title-pink">Package Rates & Services</h1>
        <div class="action-btn-group">
            <a href="{{ path('admin_package_new') }}" class="btn-create" style="text-decoration: none;">+ Add New Package</a>
        </div>
    </div>

    <div class="table-card">
        <form method="GET" action="{{ path('admin_packages') }}" class="filter-bar" style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
            <select name="search_by" class="custom-select" style="max-width: 170px;">
                <option value="all" {{ searchBy == 'all' ? 'selected' : '' }}>Search All Fields</option>
                <option value="name" {{ searchBy == 'name' ? 'selected' : '' }}>Package Name</option>
                <option value="category" {{ searchBy == 'category' ? 'selected' : '' }}>Category</option>
                <option value="duration" {{ searchBy == 'duration' ? 'selected' : '' }}>Duration</option>
                <option value="pax" {{ searchBy == 'pax' ? 'selected' : '' }}>Max Pax</option>
                <option value="price" {{ searchBy == 'price' ? 'selected' : '' }}>Price</option>
                <option value="status" {{ searchBy == 'status' ? 'selected' : '' }}>Status</option>
            </select>

            <input type="text" name="search" value="{{ searchQuery }}" placeholder="Search records..." class="custom-input" style="max-width: 280px; flex: 1;">

            <button type="submit" class="btn-act btn-approve">Search</button>

            {% if searchQuery is not empty %}
                <a href="{{ path('admin_packages') }}" class="btn-act btn-cancel" style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">Reset</a>
            {% endif %}
        </form>

        <table class="booking-table">
            <thead>
                <tr>
                    <th>PACKAGE NAME</th>
                    <th>CATEGORY</th>
                    <th>DURATION & PAX</th>
                    <th>PRICE (₱)</th>
                    <th>STATUS</th>
                    <th class="text-right">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% if packages is empty %}
                    <tr><td colspan="6" class="admin-empty-state">No studio packages found matching criteria.</td></tr>
                {% else %}
                    {% for package in packages %}
                        {% set status = package.status ?: 'active' %}
                        <tr>
                            <td><strong>{{ package.name }}</strong></td>
                            <td><span class="admin-detail">{{ package.category }}</span></td>
                            <td>
                                <span class="admin-detail">
                                    {{ package.duration ?: 'N/A' }} | Max {{ package.maxPax ?: 1 }} pax
                                </span>
                            </td>
                            <td>
                                <form method="POST" action="{{ path('admin_packages') }}" class="admin-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                    <input type="hidden" name="action" value="update_price">
                                    <input type="hidden" name="package_id" value="{{ package.packageId }}">
                                    <input type="number" step="0.01" name="price" value="{{ package.price }}" style="width: 90px; padding: 4px 8px; border-radius: 4px; border: 1px solid #ccc;">
                                    <button type="submit" class="btn-act btn-approve">Save</button>
                                </form>
                            </td>
                            <td>
                                <span class="badge-status status-{{ status == 'active' ? 'confirmed' : 'cancelled' }}">
                                    {{ status|capitalize }}
                                </span>
                            </td>
                            <td class="text-right">
                                <div class="action-btn-group">
                                    <form method="POST" action="{{ path('admin_packages') }}" class="admin-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                        <input type="hidden" name="action" value="toggle_status">
                                        <input type="hidden" name="package_id" value="{{ package.packageId }}">
                                        <input type="hidden" name="status" value="{{ status == 'active' ? 'inactive' : 'active' }}">
                                        <button type="submit" class="btn-act {{ status == 'active' ? 'btn-cancel' : 'btn-approve' }}">
                                            {{ status == 'active' ? 'Deactivate' : 'Activate' }}
                                        </button>
                                    </form>

                                    <a href="{{ path('admin_package_edit', {id: package.packageId}) }}" class="btn-act btn-approve" style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">Edit</a>

                                    <form method="POST" action="{{ path('admin_packages') }}" class="admin-inline" onsubmit="return confirm('Delete this package permanently?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_action') }}">
                                        <input type="hidden" name="action" value="delete_package">
                                        <input type="hidden" name="package_id" value="{{ package.packageId }}">
                                        <button type="submit" class="btn-act btn-delete">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}
