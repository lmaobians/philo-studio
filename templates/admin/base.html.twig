{% extends 'base.html.twig' %}

{% block title %}{{ page_title|default('Admin Control Center') }} | PHILO Studio{% endblock %}

{% block body_class %}admin-page{% endblock %}

{% block body %}
    {% set currentRoute = app.request.attributes.get('_route') %}

    <nav class="admin-nav">
        <div class="admin-brand">
            <span>ADMIN CONTROL CENTER</span>
        </div>

        <div class="admin-nav-links">
            <a href="{{ path('admin_overview') }}" class="nav-link {{ currentRoute in ['admin_overview', 'admin_entry'] ? 'active' : '' }}">Dashboard</a>
            <a href="{{ path('admin_dashboard') }}" class="nav-link {{ currentRoute in ['admin_dashboard', 'admin_booking_edit'] ? 'active' : '' }}">Records</a>
            <a href="{{ path('admin_daily_schedule') }}" class="nav-link {{ currentRoute == 'admin_daily_schedule' ? 'active' : '' }}">Schedule</a>
            <a href="{{ path('admin_blockouts') }}" class="nav-link {{ currentRoute in ['admin_blockouts', 'admin_blockout_edit'] ? 'active' : '' }}">Blockouts</a>
            <a href="{{ path('admin_packages') }}" class="nav-link {{ currentRoute in ['admin_packages', 'admin_package_new', 'admin_package_edit'] ? 'active' : '' }}">Packages</a>
            <a href="{{ path('admin_customers') }}" class="nav-link {{ currentRoute == 'admin_customers' ? 'active' : '' }}">Clients</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_user_index') }}" class="nav-link {{ currentRoute in ['admin_user_index', 'admin_user_new', 'admin_user_edit'] ? 'active' : '' }}">Users</a>
            {% endif %}
            <a href="{{ path('account_profile') }}" class="nav-link {{ currentRoute in ['account_profile', 'account_password'] ? 'active' : '' }}">Profile</a>
        </div>

        <div class="topbar-profile">
            <div class="profile-info">
                <span class="user-role">{{ app.user.roleLabel|default('Administrator') }}</span>
                <a href="{{ path('account_profile') }}" class="user-name" style="color: inherit; text-decoration: none;">{{ app.user.fullName ?: app.user.username ?: 'Admin Studio' }}</a>
            </div>
            <a href="{{ path('admin_logout') }}" class="btn-logout" title="Log Out">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Log Out</span>
            </a>
        </div>
    </nav>

    <div class="admin-container">

        {% for message in app.flashes('admin_msg') %}
            <div class="alert-toast">
                {{ message|raw }}
            </div>
        {% endfor %}
        {% for message in app.flashes('account_msg') %}
            <div class="alert-toast">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert-toast alert-toast-error">
                {{ message }}
            </div>
        {% endfor %}

        {% block admin_body %}{% endblock %}

    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    {% block admin_javascripts %}{% endblock %}
{% endblock %}
