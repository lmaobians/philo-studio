# Copy this file to .env.local and fill in the secret values for your machine.
# .env.local is ignored by Git and must never be committed.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-to-a-random-string
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://philo_user:change-me@database:3306/philostudio?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> philo studio mailer ###
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
SMTP_PORT=587
CONTACT_TO_EMAIL=philo.studio@gmail.com
###< philo studio mailer ###

###> reverse proxy (optional: ngrok, Cloudflare Tunnel, etc.) ###
# Required so Symfony generates https URLs and accepts the proxy's Origin
# header for stateless CSRF validation. nginx forwards X-Forwarded-* headers.
# SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
# SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port
###< reverse proxy (optional) ###
